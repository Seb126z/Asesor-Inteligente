# Copia este archivo como ".env" (en la raíz del proyecto) y completa los valores. ".env" NO se sube a GitHub.

APP_NAME=Asesor Pedagogico Inteligente
APP_ENV=development            # en el servidor: production

# --- Base de datos ---
# Desarrollo (por defecto): SQLite local, no necesitas configurar nada.
# DATABASE_URL=sqlite:///./storage/asesor_pedagogico.db
# Producción: cadena "pooled" de Neon (Dashboard > Connect). Incluye ?sslmode=require
# DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

MAX_UPLOAD_MB=10               # los archivos se guardan en la base de datos

# --- Autenticación ---
JWT_SECRET=                    # obligatorio en producción: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_EXPIRE_MINUTES=480
DOCENTE_NAME=Docente           # cuenta docente que se crea en producción
DOCENTE_EMAIL=
DOCENTE_PASSWORD=

# --- Modelo de IA (cualquier API compatible con OpenAI) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT=120

# Solo si el frontend se sirve desde otro dominio (separado por comas). En el mismo dominio no hace falta.
# CORS_ORIGINS=https://mi-frontend.example.com
